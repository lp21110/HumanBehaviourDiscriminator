# Text-analysis provider: ollama (default), deepseek, or private
MODEL_PROVIDER=ollama
or
MODEL_PROVIDER=deepseek
or 
MODEL_PROVIDER=private


# Ollama (optional env variables, these are the defaults)
OLLAMA_HOST=
OLLAMA_MODEL=qwen3.5:9b

# DeepSeek (when MODEL_PROVIDER=deepseek)
DEEPSEEK_API_KEY=

# Private API (when MODEL_PROVIDER=private, these are the defaults)
PRIVATE_BASE_URL=https://agx1-1.taildbf607.ts.net/v1
PRIVATE_API_KEY=
PRIVATE_MODEL=jetson/qwen3.5-9b-q8_0

# Gemini video captioning (required for video input)
GEMINI_API_KEY=

# Optional Qwen/OpenRouter video-captioning
QWEN_API_BASE_URL=https://openrouter.ai/api/v1
QWEN_API_KEY=
